# Example environment variables for local development. Copy to `.env` and fill in real values.
DEVTO_API_KEY=your_devto_api_key_here
DEVTO_ACCEPT_HEADER=application/vnd.forem.api-v1+json
DEVTO_ORG_SLUG=your_org_slug
# Optional: skips the /api/organizations/{slug} lookup if set.
# DEVTO_ORG_ID=12345
# Optional but recommended: your dev.to username. Organization-scoped analytics
# requests throttle noticeably harder than requests for your own articles, so
# setting this lets the collector skip organization_id for articles you
# authored yourself and only use it for other org members' articles.
# DEVTO_USERNAME=your_devto_username
DEVTO_SINCE=2025-06-01
OUTPUT_DIR=data
LOG_LEVEL=info

# Rate limiting (dev.to/Forem throttles API reads to ~3 req/s per key). Defaults
# below pace requests to avoid 429s; raise DEVTO_MAX_RETRIES if you'd rather let
# a run take longer than see rows come back without readers.
# DEVTO_MIN_REQUEST_INTERVAL=0.4
# DEVTO_MAX_RETRIES=6
# DEVTO_INITIAL_BACKOFF=2
